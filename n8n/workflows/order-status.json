{
  "id": "ddOrderStatus001",
  "name": "DesiDrapes: order status update → customer",
  "active": false,
  "nodes": [
    {
      "id": "order.status_changed-trigger",
      "name": "On order.status_changed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        260,
        300
      ],
      "webhookId": "desidrapes-order.status_changed",
      "parameters": {
        "httpMethod": "POST",
        "path": "order.status_changed",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "verify-api-key",
      "name": "Verify API key",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "key-configured",
              "leftValue": "={{ $env.DESIDRAPES_API_KEY ?? \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "key-matches",
              "leftValue": "={{ $json.headers[\"x-api-key\"] ?? \"\" }}",
              "rightValue": "={{ $env.DESIDRAPES_API_KEY }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "email-customer-status-update",
      "name": "Email customer: status update",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        520,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "ddMailpitSmtp001",
          "name": "Mailpit SMTP (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "fromEmail": "={{ $env.DESIDRAPES_FROM_EMAIL }}",
        "toEmail": "={{ $json.body.data.email }}",
        "subject": "=Order #{{ $json.body.data.orderNumber }}: {{ String($json.body.data.to).charAt(0) + String($json.body.data.to).slice(1).toLowerCase() }}",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#333\">\n  <div style=\"padding:20px 0;border-bottom:2px solid #7a1f3d\">\n    <span style=\"font-family:Georgia,serif;font-size:24px;color:#7a1f3d\">DesiDrapes</span>\n  </div>\n  <h2 style=\"font-weight:normal;margin:24px 0 12px\">Hi {{ String($json.body.data.customerName ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'})[c]) }},</h2>\n  <p>{{ ({SHIPPED:'Good news, your order is on its way!',DELIVERED:'Your order has been delivered. We hope you love it!',PROCESSING:'We are preparing your order.',CANCELLED:'Your order was cancelled. If you were charged, a refund has been issued.'})[$json.body.data.to] || ('Your order is now ' + String($json.body.data.to).toLowerCase() + '.') }}</p><p style=\"margin:24px 0\"><a href=\"{{ $json.body.data.orderUrl }}\" style=\"background:#111;color:#fff;padding:12px 22px;text-decoration:none\">Track your order</a></p>\n  <p style=\"margin-top:32px;font-size:12px;color:#999;border-top:1px solid #eee;padding-top:12px\">\n    DesiDrapes · Indian ethnic wear, delivered across Australia.<br>\n    This is a demo store running locally; this email was captured by Mailpit and never sent to a real inbox.\n  </p>\n</div>",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "reject-unauthorised",
      "name": "Reject: invalid API key",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        780,
        500
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "Rejected event: missing or invalid x-api-key header"
      }
    }
  ],
  "connections": {
    "On order.status_changed": {
      "main": [
        [
          {
            "node": "Verify API key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify API key": {
      "main": [
        [
          {
            "node": "Email customer: status update",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject: invalid API key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": [],
  "versionId": "7223604f-a685-4690-8b57-1c1edcb2aaf4"
}
