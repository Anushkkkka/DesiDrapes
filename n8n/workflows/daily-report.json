{
  "id": "ddDailyReport001",
  "name": "DesiDrapes: daily sales report (n8n → API → email)",
  "active": false,
  "nodes": [
    {
      "id": "daily-schedule",
      "name": "Every day at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        260,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "fetch-report",
      "name": "Fetch yesterday’s sales from API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DESIDRAPES_API_URL }}/api/internal/reports/daily",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.DESIDRAPES_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "email-admin-daily-report",
      "name": "Email admin: daily report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        780,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "ddMailpitSmtp001",
          "name": "Mailpit SMTP (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "fromEmail": "={{ $env.DESIDRAPES_FROM_EMAIL }}",
        "toEmail": "={{ $env.DESIDRAPES_ADMIN_EMAIL }}",
        "subject": "=Daily sales {{ $json.date }}: {{ '$' + Number($json.revenue).toFixed(2) }} from {{ $json.paidOrders }} order(s)",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#333\">\n  <div style=\"padding:20px 0;border-bottom:2px solid #7a1f3d\">\n    <span style=\"font-family:Georgia,serif;font-size:24px;color:#7a1f3d\">DesiDrapes</span>\n  </div>\n  <h2 style=\"font-weight:normal;margin:24px 0 12px\">Sales report for {{ $json.date }}</h2>\n  <table style=\"font-size:15px;line-height:1.8\">\n    <tr><td>Revenue</td><td style=\"padding-left:24px\"><strong>{{ '$' + Number($json.revenue).toFixed(2) }}</strong></td></tr>\n    <tr><td>Paid orders</td><td style=\"padding-left:24px\">{{ $json.paidOrders }}</td></tr>\n    <tr><td>Orders placed</td><td style=\"padding-left:24px\">{{ $json.ordersPlaced }}</td></tr>\n    <tr><td>New customers</td><td style=\"padding-left:24px\">{{ $json.newCustomers }}</td></tr>\n    <tr><td>Low-stock sizes</td><td style=\"padding-left:24px\">{{ $json.lowStockCount }}</td></tr>\n  </table>\n  <p style=\"margin-top:16px\"><strong>Restock soon:</strong><br>{{ $json.lowStock.slice(0, 10).map(v => String(v.name ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'})[c]) + ' (' + v.size + '): ' + v.stock).join('<br>') || 'Nothing, all healthy.' }}</p>\n  <p style=\"margin-top:32px;font-size:12px;color:#999;border-top:1px solid #eee;padding-top:12px\">\n    DesiDrapes · Indian ethnic wear, delivered across Australia.<br>\n    This is a demo store running locally; this email was captured by Mailpit and never sent to a real inbox.\n  </p>\n</div>",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "manual-run",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        500
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every day at 8am": {
      "main": [
        [
          {
            "node": "Fetch yesterday’s sales from API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch yesterday’s sales from API": {
      "main": [
        [
          {
            "node": "Email admin: daily report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual)": {
      "main": [
        [
          {
            "node": "Fetch yesterday’s sales from API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": [],
  "versionId": "6431e6e7-5f1b-4d21-8096-986fa5002bf1"
}
