# DesiDrapes environment configuration
# Copy to `.env` at the repo root:  cp .env.example .env
# One file serves `docker compose`, the API (npm run dev:backend) and the Prisma CLI.
# Everything works with the defaults below: no paid service or real key is required.
# Docker Compose overrides the host names (db, redis, n8n) for containers automatically.

# --- Core --------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Postgres from `docker compose up -d db` (use host "db" only inside containers)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/desidrapes
POSTGRES_PASSWORD=postgres
# Optional: product-list cache. Leave empty to run without Redis.
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------
# REQUIRED, at least 16 chars. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Defaults to true when NODE_ENV=production; set false only for plain-http local testing.
# COOKIE_SECURE=false

# --- URLs --------------------------------------------------------------------
# Where customers are sent back after checkout and password-reset links.
# 5173 = Vite dev server; Docker Compose uses 3000.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Payments (optional) -----------------------------------------------------
# Empty = built-in simulated checkout (no money, no card data).
# To try Stripe, use TEST keys only (sk_test_...), never live keys:
#   STRIPE_SECRET_KEY from https://dashboard.stripe.com/test/apikeys
#   STRIPE_WEBHOOK_SECRET from `stripe listen --forward-to localhost:4000/api/payments/webhook`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Automation (n8n) --------------------------------------------------------
# Where the API posts domain events. Empty disables event delivery.
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# REQUIRED by docker compose. Shared secret between the API and n8n, both directions: the API sends it
# with every event (workflows reject events without it) and n8n sends it to /api/internal/*.
# Use a long random value for any shared or deployed environment.
N8N_API_KEY=local-n8n-service-key
# Where n8n (in Docker) reaches the API for scheduled reports. Default http://backend:4000 is
# correct for the full Docker stack; uncomment when the API runs on your machine (npm run dev:backend).
# DESIDRAPES_API_URL=http://host.docker.internal:4000
# Encrypts credentials stored inside n8n. Keep it stable or n8n can't read saved credentials.
N8N_ENCRYPTION_KEY=local-dev-n8n-encryption-key
ADMIN_ALERT_EMAIL=admin@desidrapes.local
TZ=Australia/Sydney

# --- AI (optional) -----------------------------------------------------------
# Any OpenAI-compatible endpoint. Empty key with the OpenAI URL = keyword-matching fallback (free).
# Free local option: install Ollama, `ollama pull llama3.2`, then set:
#   AI_BASE_URL=http://localhost:11434/v1   (from Docker: http://host.docker.internal:11434/v1)
#   AI_MODEL=llama3.2
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Store settings ----------------------------------------------------------
SHIPPING_FLAT_FEE=10
FREE_SHIPPING_THRESHOLD=150

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
# pretty (default in dev) | json (default in production)
# LOG_FORMAT=pretty
